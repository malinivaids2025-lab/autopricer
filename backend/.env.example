# AutoPricer AI Backend Environment Configuration

# Server Port (Render sets this automatically via $PORT)
PORT=8000

# Allowed CORS Origins (comma-separated list of allowed frontend origins)
# For Local Development:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# For Production (Render):
# Add your Vercel deployment URL(s):
# ALLOWED_ORIGINS=https://autopricer-ai.vercel.app,http://localhost:5173

# Optional: Regex pattern to allow all preview deployments from Vercel
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
